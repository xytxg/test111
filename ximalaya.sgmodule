#!name=喜马拉雅 Surge 兼容版
#!desc=将原 Quantumult X/Loon 重写规则改为 Surge 原生语法，保留原脚本执行路径与响应处理逻辑
#!category=工具

[Script]
喜马拉雅响应处理 = type=http-response,pattern=^https?:\/\/.+((ximalaya)|(xmcdn)).+(mobile-user\/v2\/homePage|product\/detail\/v1|v1\/album\/track\/ts|mobile-playpage\/track\/v4\/baseInfo\/ts|mobile-playpage\/playpage\/tabs\/v2|mobile-playpage\/playpage\/track\/qualityAndEffect|mobile\/download\/v2\/track|mobile-user-grade\/decoratorV2\/decorationDetails\/page|mobile-album\/album\/plant\/grass),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/ximalaya.js

[URL Rewrite]
^https?:\/\/passport\.ximalaya\.com\/friendship-mobile\/v1\/findFriendsBanner\/show\/ _ reject
^https?:\/\/xdcs-collector\.ximalaya\.com\/api\/v1\/realtime _ reject
^https?:\/\/adse\.wsa\.ximalaya\.com _ reject
^https?:\/\/adse\.ximalaya\.com _ reject
^https?:\/\/ad\.ximalaya\.com _ reject
^https?:\/\/ulogs\.umeng\.com\/unify_logs _ reject
^https?:\/\/mobile\.ximalaya\.com\/business-sale-promotion-guide-mobile-web\/popup\/info\/ _ reject

[Map Local]
^https?:\/\/.+ximalaya\.com\/x-web-activity\/signIn\/getHomePageSignInInfo\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/.+ximalaya\.com\/product\/promotion\/v1\/album\/price data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https:\/\/(m|mwsa)\.ximalaya\.com\/community\/square\/v\d\/stream\? data-type=base64 data="eyJkYXRhIjp7ImNhcmRzIjpbeyJjb250ZW50Ijp7fSwidHlwZSI6IlJFQ09NTUVORFMifV19LCJyZXQiOjB9" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% *.ximalaya.com, *.xmcdn.com, passport.ximalaya.com, xdcs-collector.ximalaya.com, adse.wsa.ximalaya.com, adse.ximalaya.com, ad.ximalaya.com, mobile.ximalaya.com, mobwsa.ximalaya.com, ulogs.umeng.com
