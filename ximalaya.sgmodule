#!name=喜马拉雅 Surge 兼容版
#!desc=修复 Surge 下请求未命中、HTTPDNS/IP 直连 MITM 缺失及新版接口路径变化；保留原脚本响应处理逻辑
#!category=工具

[Script]
# 原脚本本身包含 Surge 运行环境兼容。这里同时兼容 9.4.x 旧路径与 9.5.x 已出现的新路径。
喜马拉雅响应处理 = type=http-response,pattern=^https?:\/\/(?:[^\/]+\.)?(?:ximalaya\.com|xmcdn\.com)\/.*(?:mobile-user\/v2\/homePage|product\/detail\/v1|v1\/album\/track\/ts|mobile\/v1\/album\/track|mobile-playpage\/track\/v4\/baseInfo(?:\/ts)?|mobile-playpage\/playpage\/tabs\/v2|mobile-playpage\/playpage\/track\/qualityAndEffect|mobile\/download\/v2\/track|mobile-user-grade\/decoratorV2\/decorationDetails\/page|mobile-album\/album\/plant\/grass),requires-body=true,max-size=-1,timeout=30,script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/ximalaya.js

[URL Rewrite]
# 广告/统计请求：兼容 hera 新域名
^https?:\/\/passport\.ximalaya\.com\/friendship-mobile\/v1\/findFriendsBanner\/show\/ _ reject
^https?:\/\/xdcs-collector(?:hera)?\.ximalaya\.com\/(?:api|nyx)\/v1\/ _ reject
^https?:\/\/(?:adse\.wsa|adse|adsehera|adbehavior)\.ximalaya\.com(?:\/|$) _ reject
^https?:\/\/ad\.ximalaya\.com(?:\/|$) _ reject
^https?:\/\/ulogs\.umeng\.com\/unify_logs _ reject
^https?:\/\/mobile\.ximalaya\.com\/business-sale-promotion-guide-mobile-web\/popup\/info\/ _ reject

[Map Local]
# 对应原 QX 的 reject-200
^https?:\/\/[^\/]*ximalaya\.com\/x-web-activity\/signIn\/getHomePageSignInInfo\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*ximalaya\.com\/product\/promotion\/v1\/album\/price data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# Script Hub 转换失败的 Loon v2 response.body.mock：改为 Surge 原生 Map Local
^https:\/\/(?:m|mwsa)\.ximalaya\.com\/community\/square\/v\d+\/stream\? data-type=base64 data="eyJkYXRhIjp7ImNhcmRzIjpbeyJjb250ZW50Ijp7fSwidHlwZSI6IlJFQ09NTUVORFMifV19LCJyZXQiOjB9" status-code=200 header="Content-Type:application/json"

[MITM]
# Ximalaya 大量使用 HTTPDNS/IP 直连。只写 *.ximalaya.com 会导致部分请求完全绕过 Surge 的 HTTP 脚本。
